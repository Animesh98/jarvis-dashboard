# Required
JELLYFIN_API_KEY=
# Free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Torrent client: "qbittorrent" (default) or "transmission"
TORRENT_CLIENT=qbittorrent

# qBittorrent (if TORRENT_CLIENT=qbittorrent)
QBIT_USER=
QBIT_PASS=
# QBIT_BASE=http://localhost:8080/api/v2

# Transmission (if TORRENT_CLIENT=transmission)
# TRANSMISSION_BASE=http://localhost:9091/transmission/rpc
# TRANSMISSION_USER=
# TRANSMISSION_PASS=

# Optional (defaults shown)
# MEDIA_PATH=/data/media
# FILE_HOME=             # Defaults to current user's home directory
# WEATHER_CITY=          # e.g. "London" — leave empty to disable weather
# JELLYFIN_BASE=http://localhost:8096

# API key for direct backend access (bypassed for localhost/Next.js proxy)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# Comma-separated list of enabled features, or "all" (default).
# Recognized: system,docker,torrents,media,discover,files,tasks
# `discover` is always on regardless of this setting.
# ENABLED_FEATURES=all

# Optional: human-memorable unlock password. When set, the browser prompt
# accepts this password and fetches the API key automatically — no need to
# look up API_KEY on new devices.
# DASHBOARD_PASSWORD=

# Optional: public base URL for shareable movie links, served via Tailscale
# Funnel (must point at this backend, e.g. a funnelled port). Leave empty to
# disable the Media "Share" feature.
# Enable the funnel with: tailscale funnel --bg --https=10000 http://127.0.0.1:8002
# PUBLIC_SHARE_BASE=https://<machine>.<tailnet>.ts.net:10000
